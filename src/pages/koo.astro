---
import Layout from "@/layouts/Layout.astro";
import { siteConfig } from "@/config";
import { allKo, getCurrentKo, getPreviousKo, getNextKo } from "@/data/ko";
import { allWashi } from "@/data/washi";

const staticCurrent = getCurrentKo();
const staticPrevious = getPreviousKo(staticCurrent);
const staticNext = getNextKo(staticCurrent);
const totalKo = allKo.length;

const allKoJson = JSON.stringify(
    allKo.map((k) => ({
        id: k.id,
        kanji: k.kanji,
        romaji: k.romaji,
        en: k.en,
        sekki: k.sekki,
        sekkiRomaji: k.sekkiRomaji,
        sekkiEn: k.sekkiEn,
        startMonth: k.startMonth,
        startDay: k.startDay,
        washi: allWashi[k.id] ?? null,
    })),
);
---

<Layout
    title="/koo | Sahil A."
    description="The 72 microseasons of the traditional Japanese calendar, indexed and updated to the day."
>
  <div class="koo-page">
        <!-- ================= HERO ================= -->
        <header class="koo-hero">
            <span class="koo-kicker">// kō &nbsp;·&nbsp; 七十二候</span>
            <h1 class="koo-title">Seventy-two <em>microseasons</em></h1>

            <div class="koo-banner" id="koo-banner" hidden>
                <div class="koo-banner-media">
                    <img
                        id="koo-banner-img"
                        alt=""
                        loading="lazy"
                        width="1600"
                        height="900"
                    />
                </div>
                <div class="koo-banner-body">
                    <p class="koo-banner-cap" id="koo-banner-cap"></p>
                    <a
                        class="koo-banner-credit"
                        id="koo-banner-credit"
                        href="#"
                        target="_blank"
                        rel="noreferrer"></a>
                </div>
            </div>

            <p class="koo-lede">
                The <em>Shichijūnikō</em> (七十二候) are the 72 microseasons of the
                traditional Japanese calendar. Each kō (候) lasts about five days,
                marking the subtle shifts in nature — from the first thaw to the last
                frost.
            </p>
            <div class="koo-hero-meta">
                <span>index of the turning year</span>
                <span aria-hidden="true">↳</span>
                <span><span id="koo-today"></span></span>
            </div>
        </header>

        <!-- ================= CURRENT ================= -->
        <section class="koo-section">
            <header class="koo-section-head">
                <span class="koo-num">01</span>
                <span class="koo-label">Current microseason</span>
                <span class="koo-rule" aria-hidden="true"></span>
                <span class="koo-side-note" id="koo-index">候 #0 / 72</span>
            </header>

            <div class="koo-now">
                <p class="koo-now-kanji" id="koo-kanji">
                    {staticCurrent.kanji}
                </p>
                <p class="koo-now-romaji" id="koo-romaji">
                    {staticCurrent.romaji}
                </p>
                <p class="koo-now-en" id="koo-en">{staticCurrent.en}.</p>

                <div class="koo-now-rule" aria-hidden="true"></div>

                <p class="koo-now-sekki">
                    in the division of
                    <span class="koo-now-sekki-name" id="koo-sekki"
                        >{staticCurrent.sekki}</span
                    >
                    <span class="koo-now-sekki-meta">
                        (<span id="koo-sekki-romaji"
                            >{staticCurrent.sekkiRomaji}</span
                        >) — <span id="koo-sekki-en"
                            >{staticCurrent.sekkiEn}</span
                        >.
                    </span>
                </p>

                <p class="koo-now-washi" id="koo-washi">
                    <span
                        class="koo-now-washi-swatch"
                        id="koo-washi-swatch"></span>
                    <span class="koo-now-washi-name" id="koo-washi-name"
                        >和色 —</span
                    >
                    <span class="koo-now-washi-hex" id="koo-washi-hex"></span>
                </p>

                <div class="koo-moon" id="koo-moon">
                    <span class="koo-moon-label">moon phase</span>
                    <span class="koo-moon-phase">
                        <span class="koo-moon-emoji" id="koo-moon-emoji"
                            >🌙</span
                        >
                        <span class="koo-moon-name" id="koo-moon-name">…</span>
                    </span>
                    <span class="koo-moon-meta" id="koo-moon-meta">—</span>
                    <a
                        class="koo-moon-credit"
                        href="https://sunrise-sunset.org"
                        target="_blank"
                        rel="noreferrer"
                        id="koo-moon-credit">via sunrise-sunset.org</a
                    >
                </div>

                <div class="koo-now-foot">
                    <span class="koo-now-range" id="koo-range">—</span>
                    <span class="koo-now-progress">
                        <span class="koo-now-progress-bar">
                            <span
                                class="koo-now-progress-fill"
                                id="koo-progress-fill"></span>
                        </span>
                        <span
                            class="koo-now-progress-label"
                            id="koo-progress-label">position in the year</span
                        >
                    </span>
                </div>
            </div>
        </section>

        <!-- ================= PREV / NEXT ================= -->
        <section class="koo-section">
            <header class="koo-section-head">
                <span class="koo-num">02</span>
                <span class="koo-label">Neighbours</span>
                <span class="koo-rule" aria-hidden="true"></span>
                <span class="koo-side-note">before &amp; after</span>
            </header>

            <div class="koo-nav">
                <div class="koo-nav-card">
                    <span class="koo-nav-kicker">← previous</span>
                    <div class="koo-nav-body" id="koo-prev">
                        <p class="koo-nav-kanji">{staticPrevious.kanji}</p>
                        <p class="koo-nav-romaji">{staticPrevious.romaji}</p>
                        <p class="koo-nav-en">{staticPrevious.en}.</p>
                        <p class="koo-nav-meta">
                            <span class="koo-nav-meta-name"
                                >{staticPrevious.sekki}</span
                            >
                            <span
                                >({staticPrevious.sekkiRomaji}) · {
                                    staticPrevious.sekkiEn
                                }</span
                            >
                        </p>
                    </div>
                </div>

                <div class="koo-nav-card">
                    <span class="koo-nav-kicker">next →</span>
                    <div class="koo-nav-body" id="koo-next">
                        <p class="koo-nav-kanji">{staticNext.kanji}</p>
                        <p class="koo-nav-romaji">{staticNext.romaji}</p>
                        <p class="koo-nav-en">{staticNext.en}.</p>
                        <p class="koo-nav-meta">
                            <span class="koo-nav-meta-name"
                                >{staticNext.sekki}</span
                            >
                            <span
                                >({staticNext.sekkiRomaji}) · {
                                    staticNext.sekkiEn
                                }</span
                            >
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= ALL 72 ================= -->
        <section class="koo-section">
            <header class="koo-section-head">
                <span class="koo-num">03</span>
                <span class="koo-label">All {totalKo} microseasons</span>
                <span class="koo-rule" aria-hidden="true"></span>
                <span class="koo-side-note">the full wheel</span>
            </header>

            <div class="koo-grid" id="koo-grid">
                {
                    allKo.map((ko) => {
                        const isActive = ko.id === staticCurrent.id;
                        return (
                            <div
                                class:list={[
                                    "koo-cell",
                                    isActive ? "koo-cell--active" : "",
                                ]}
                                data-ko-id={ko.id}
                            >
                                <div class="koo-cell-head">
                                    <span class="koo-cell-id">#{ko.id}</span>
                                    {isActive && (
                                        <span class="koo-cell-badge">now</span>
                                    )}
                                </div>
                                <p class="koo-cell-kanji">{ko.kanji}</p>
                                <p class="koo-cell-romaji">{ko.romaji}</p>
                            </div>
                        );
                    })
                }
            </div>
        </section>
  </div>
</Layout>

<div id="koo-data" hidden>{allKoJson}</div>
<script define:vars={{ prodApiBaseUrl: siteConfig.apiBaseUrl }}>
    function initKoo() {
        const kooDataEl = document.getElementById("koo-data");
        if (!kooDataEl) return;
        const allKo = JSON.parse(kooDataEl.textContent);

    const apiBaseUrl =
        location.hostname === "localhost" || location.hostname === "127.0.0.1"
            ? "http://localhost:8080"
            : prodApiBaseUrl;

    const moonEl = document.getElementById("koo-moon");
    if (moonEl) {
        fetch(`${apiBaseUrl}/api/moon`, { signal: AbortSignal.timeout(8000) })
            .then((r) => (r.ok ? r.json() : null))
            .then((m) => {
                if (!m) throw new Error("empty");
                document.getElementById("koo-moon-emoji").textContent =
                    m.emoji || "🌙";
                document.getElementById("koo-moon-name").textContent =
                    m.phaseName || "—";
                const illum =
                    typeof m.illumination === "number"
                        ? `${Math.round(m.illumination)}% illuminated`
                        : "—";
                document.getElementById("koo-moon-meta").textContent = illum;
            })
            .catch(() => {
                moonEl.style.display = "none";
            });
    }

    const daysInMonth = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    function dayOfYear(m, d) {
        let doy = 0;
        for (let i = 0; i < m - 1; i++) doy += daysInMonth[i];
        return doy + d;
    }

    function findKo() {
        const now = new Date();
        const today = dayOfYear(now.getMonth() + 1, now.getDate());
        for (let i = 0; i < allKo.length; i++) {
            const start = dayOfYear(allKo[i].startMonth, allKo[i].startDay);
            const end = allKo[i + 1]
                ? dayOfYear(allKo[i + 1].startMonth, allKo[i + 1].startDay) - 1
                : 365;
            if (today >= start && today <= end) return allKo[i];
        }
        return allKo[allKo.length - 1];
    }

    function getPrev(ko) {
        const idx = allKo.indexOf(ko);
        return allKo[(idx - 1 + allKo.length) % allKo.length];
    }

    function getNext(ko) {
        const idx = allKo.indexOf(ko);
        return allKo[(idx + 1) % allKo.length];
    }

    const MONTHS = [
        "January",
        "February",
        "March",
        "April",
        "May",
        "June",
        "July",
        "August",
        "September",
        "October",
        "November",
        "December",
    ];
    const fmt = (m, d) => `${MONTHS[m - 1]} ${d}`;

    function koRange(ko, next) {
        const start = `${fmt(ko.startMonth, ko.startDay)}`;
        const endD = dayOfYear(next.startMonth, next.startDay) - 1;
        let em = next.startMonth;
        let ed = next.startDay - 1;
        if (ed <= 0) {
            em -= 1;
            ed = daysInMonth[em - 1];
        }
        return `${start} – ${fmt(em, ed)}`;
    }

    function renderKo(ko) {
        const idx = allKo.indexOf(ko);
        const next = getNext(ko);
        const today = dayOfYear(
            new Date().getMonth() + 1,
            new Date().getDate(),
        );
        const yearPct = Math.round((today / 365) * 100);

        document.getElementById("koo-index").textContent =
            `候 #${ko.id} / ${allKo.length}`;
        document.getElementById("koo-kanji").textContent = ko.kanji;
        document.getElementById("koo-romaji").textContent = ko.romaji;
        document.getElementById("koo-en").textContent = ko.en + ".";
        document.getElementById("koo-sekki").textContent = ko.sekki;
        document.getElementById("koo-sekki-romaji").textContent =
            ko.sekkiRomaji;
        document.getElementById("koo-sekki-en").textContent = ko.sekkiEn + ".";
        document.getElementById("koo-range").textContent = koRange(ko, next);
        document.getElementById("koo-progress-fill").style.width =
            yearPct + "%";

        const washi = ko.washi;
        document.documentElement.style.setProperty("--accent", washi.hex);
        const swatch = document.getElementById("koo-washi-swatch");
        if (swatch) swatch.style.background = washi.hex;
        const wname = document.getElementById("koo-washi-name");
        if (wname) wname.textContent = `和色 ${washi.name}`;
        const whex = document.getElementById("koo-washi-hex");
        if (whex) whex.textContent = washi.hex.toUpperCase();

        document.getElementById("koo-progress-label").textContent =
            `day ${today} of 365 · ${yearPct}% through the year`;
        document.getElementById("koo-today").textContent =
            new Date().toLocaleDateString("en-US", {
                month: "long",
                day: "numeric",
                year: "numeric",
            });

        const prev = getPrev(ko);
        const prevEl = document.getElementById("koo-prev");
        prevEl.innerHTML = `
            <p class="koo-nav-kanji">${prev.kanji}</p>
            <p class="koo-nav-romaji">${prev.romaji}</p>
            <p class="koo-nav-en">${prev.en}.</p>
            <p class="koo-nav-meta">
                <span class="koo-nav-meta-name">${prev.sekki}</span>
                <span>(${prev.sekkiRomaji}) · ${prev.sekkiEn}</span>
            </p>
        `;

        const nextEl = document.getElementById("koo-next");
        nextEl.innerHTML = `
            <p class="koo-nav-kanji">${next.kanji}</p>
            <p class="koo-nav-romaji">${next.romaji}</p>
            <p class="koo-nav-en">${next.en}.</p>
            <p class="koo-nav-meta">
                <span class="koo-nav-meta-name">${next.sekki}</span>
                <span>(${next.sekkiRomaji}) · ${next.sekkiEn}</span>
            </p>
        `;

        document.querySelectorAll("#koo-grid > div").forEach((el) => {
            const id = parseInt(el.dataset.koId);
            const isActive = id === ko.id;
            el.classList.toggle("koo-cell--active", isActive);
            const badge = el.querySelector(".koo-cell-badge");
            if (isActive && !badge) {
                const span = document.createElement("span");
                span.className = "koo-cell-badge";
                span.textContent = "now";
                el.querySelector(".koo-cell-head").appendChild(span);
            } else if (!isActive && badge) {
                badge.remove();
            }
        });
    }

    renderKo(findKo());

    // ---- kō image banner ----
    const banner = document.getElementById("koo-banner");
    if (banner) {
        const ko = findKo();
        const query = ko.en
            .replace(
                /\b(and|or|of|the|a|an|to|from|in|on|for|with|begin|begins|beginning|end|ends|ending|until|under|over|into|through|no|not|be|is|are)\b/gi,
                " ",
            )
            .replace(/\s+/g, " ")
            .trim();
        fetch(`${apiBaseUrl}/api/koo-image?q=${encodeURIComponent(query)}`, {
            signal: AbortSignal.timeout(8000),
        })
            .then((r) => (r.ok ? r.json() : null))
            .then((img) => {
                if (!img || (!img.url && !img.direct_url && !img.thumbnail))
                    throw new Error("empty");
                const el = document.getElementById("koo-banner-img");
                el.src = img.url || img.direct_url || img.thumbnail;
                el.alt = img.title || ko.en;
                document.getElementById("koo-banner-cap").textContent =
                    ko.en + ".";
                const credit = document.getElementById("koo-banner-credit");
                credit.href = img.foreign_landing_url || img.license_url || "#";
                credit.textContent = img.creator
                    ? `${img.creator} · ${img.license}`.toUpperCase()
                    : (img.license || "source").toUpperCase();
                banner.hidden = false;
            })
            .catch(() => {
                banner.hidden = true;
            });
    }
    }

    if (!window.__kooInitBound) {
        window.__kooInitBound = true;
        document.addEventListener("astro:page-load", initKoo);
    }
</script>

<style is:global>
    /* ============ scaffold ============ */
    .koo-page {
        margin: clamp(2.5rem, 6vw, 5rem) auto;
        padding: 0 clamp(1.25rem, 4vw, 2.5rem);
        max-width: 56rem;
        display: flex;
        flex-direction: column;
        gap: clamp(3rem, 7vw, 5rem);
    }

    /* ============ hero ============ */
    .koo-hero {
        border-bottom: 1px solid var(--border);
        padding-bottom: clamp(2rem, 5vw, 3rem);
    }
    .koo-kicker {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted-foreground);
    }
    .koo-title {
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: clamp(2.4rem, 8vw, 4.2rem);
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 1.25rem 0 1rem;
        color: var(--foreground);
    }
    .koo-title em {
        font-style: italic;
        color: var(--accent);
        font-weight: 500;
    }
    .koo-lede {
        font-size: clamp(1rem, 2.4vw, 1.15rem);
        max-width: 38em;
        color: var(--muted-foreground);
        line-height: 1.55;
    }
    .koo-hero-meta {
        margin-top: 1.75rem;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        color: var(--muted-foreground);
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }
    .koo-hero-meta span[aria-hidden] {
        color: var(--accent);
    }

    /* ============ sections ============ */
    .koo-section {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }
    .koo-section-head {
        display: flex;
        align-items: baseline;
        gap: 1rem;
    }

    /* ============ kō image banner ============ */
    .koo-banner {
        position: relative;
        width: 100%;
        height: clamp(12rem, 26vw, 20rem);
        overflow: hidden;
        border-radius: 0.375rem;
        border: 1px solid var(--border);
        margin: 1.5rem 0;
    }
    .koo-banner-media {
        position: absolute;
        inset: 0;
    }
    .koo-banner-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .koo-banner::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            180deg,
            color-mix(in srgb, var(--background) 10%, transparent) 0%,
            color-mix(in srgb, var(--background) 82%, transparent) 100%
        );
        pointer-events: none;
    }
    .koo-banner-body {
        position: absolute;
        inset-inline: 0;
        bottom: 0;
        padding: 1rem 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.15rem;
        z-index: 1;
    }
    .koo-banner-kicker {
        font-family: var(--font-mono);
        font-size: 0.62rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--foreground);
        opacity: 0.85;
    }
    .koo-banner-cap {
        font-family: var(--font-serif);
        font-weight: 600;
        font-style: italic;
        font-size: clamp(1rem, 2.6vw, 1.35rem);
        color: var(--foreground);
        margin: 0;
        line-height: 1.3;
    }
    .koo-banner-credit {
        font-family: var(--font-mono);
        font-size: 0.6rem;
        letter-spacing: 0.08em;
        color: var(--foreground);
        opacity: 0.7;
        text-decoration: none;
        margin-top: 0.15rem;
    }
    .koo-banner-credit:hover {
        opacity: 1;
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .koo-num {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--accent);
        letter-spacing: 0.05em;
    }
    .koo-label {
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: clamp(1.3rem, 3vw, 1.6rem);
        color: var(--foreground);
        letter-spacing: -0.01em;
    }
    .koo-rule {
        flex: 1;
        border-bottom: 1px dashed var(--border);
        align-self: center;
        margin-bottom: 0.35em;
        min-width: 1.5rem;
    }
    .koo-side-note {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--muted-foreground);
        white-space: nowrap;
    }

    /* ============ current ============ */
    .koo-now {
        border-top: 1px solid var(--border);
        padding-top: 2rem;
    }
    .koo-now-kanji {
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: clamp(3.5rem, 14vw, 7rem);
        line-height: 1;
        letter-spacing: 0.02em;
        color: var(--foreground);
        margin: 0;
    }
    .koo-now-romaji {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: clamp(1.1rem, 3vw, 1.4rem);
        color: var(--accent);
        margin-top: 1.25rem;
    }
    .koo-now-en {
        font-family: var(--font-serif);
        font-size: clamp(1.2rem, 3.5vw, 1.6rem);
        font-weight: 500;
        color: var(--foreground);
        max-width: 32em;
        line-height: 1.4;
        margin-top: 0.4rem;
    }
    .koo-now-rule {
        border-bottom: 1px solid var(--border);
        margin: 1.5rem 0;
    }
    .koo-now-sekki {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--muted-foreground);
        line-height: 1.7;
    }
    .koo-now-sekki-name {
        font-family: var(--font-sans);
        font-weight: 600;
        color: var(--foreground);
    }
    .koo-now-washi {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem 0.7rem;
        margin-top: 1rem;
    }
    .koo-now-washi-swatch {
        width: 1rem;
        height: 1rem;
        border-radius: 2px;
        border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border));
        background: var(--accent);
        flex: 0 0 auto;
    }
    .koo-now-washi-name {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--foreground);
    }
    .koo-now-washi-hex {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        color: var(--muted-foreground);
        letter-spacing: 0.04em;
    }
    /* ============ moon ============ */
    .koo-moon {
        margin-top: 1.5rem;
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.4rem 0.8rem;
        border-top: 1px dashed var(--border);
        padding-top: 1.25rem;
    }
    .koo-moon-label {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--muted-foreground);
        flex-basis: 100%;
    }
