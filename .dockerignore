# Build context for Dockerfile.frontend (Astro static site build).

# dependencies and build output — regenerated inside the image
node_modules/
dist/
.astro/
test-results/
playwright-report/

# version control — not needed for the build
.git/
**/.git

# local environment and secrets — never copy into images
.env
.env.*
*.pem
*.key

# other workspace parts not needed to build the site
# (api/ has its own build context and Dockerfile)
api/
obsidian-plugin/

# editor / tooling state
.vscode/
.crush/

# CI and coverage artifacts
.github/
lighthouse/report-*.json
